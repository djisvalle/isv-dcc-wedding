rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    // Bootstrap admin emails below must be kept in sync by hand with
    // src/lib/adminEmails.ts (rules can't import TS). Once an email has
    // signed in, AdminLogin.tsx creates its `admins/{uid}` doc, which is
    // what actually grants access here going forward.
    function isAdmin() {
      return isSignedIn() &&
             (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
              request.auth.token.email == "israelvalle48@gmail.com" ||
              request.auth.token.email == "debcarumba@gmail.com" ||
              request.auth.token.email == "joshj.alzate77@gmail.com");
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    // --- Entity Validations ---
    function isValidInvite(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!data.keys().hasAny(['import_order']) || data.import_order == null || data.import_order is number) &&
             (!data.keys().hasAny(['guest_ids']) || data.guest_ids == null || (data.guest_ids is list && data.guest_ids.size() <= 500));
    }

    function isValidGuest(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!data.keys().hasAny(['nickname']) || data.nickname == null || (data.nickname is string && data.nickname.size() <= 100)) &&
             (!data.keys().hasAny(['invite_id']) || (data.invite_id == null || isValidId(data.invite_id))) &&
             (!data.keys().hasAny(['role']) || data.role == null || (data.role is string && data.role.size() <= 100)) &&
             (!data.keys().hasAny(['table_type']) || data.table_type == null || data.table_type in ['bridal', 'vip', 'regular']) &&
             (!data.keys().hasAny(['table_number']) || data.table_number == null || (data.table_number is string && data.table_number.size() <= 50)) &&
             (!data.keys().hasAny(['table_order']) || data.table_order == null || data.table_order is number) &&
             (!data.keys().hasAny(['import_order']) || data.import_order == null || data.import_order is number) &&
             (!data.keys().hasAny(['is_coming']) || data.is_coming == null || data.is_coming is bool) &&
             (!data.keys().hasAny(['is_baby_or_child']) || data.is_baby_or_child == null || data.is_baby_or_child is bool) &&
             (!data.keys().hasAny(['parent_name']) || data.parent_name == null || (data.parent_name is string && data.parent_name.size() <= 100));
    }

    function isValidSetting(settingId, data) {
      return data.keys().hasAll(['key', 'value']) &&
             data.key is string && data.key.size() > 0 &&
             (
               (settingId == 'rsvp_deadline' && (data.value == null || data.value is timestamp)) ||
               (settingId != 'rsvp_deadline' && data.value is string && data.value.size() >= 0)
             );
    }

    // RSVP writes from the public (non-admin) branch are blocked once the
    // deadline has passed. Anything other than a real timestamp on the
    // deadline doc (missing, null, or a pre-migration string value) is
    // treated as "no deadline set" rather than blocking every RSVP.
    function isBeforeRsvpDeadline() {
      let deadlinePath = /databases/$(database)/documents/settings/rsvp_deadline;
      return !exists(deadlinePath) ||
             !('value' in get(deadlinePath).data) ||
             get(deadlinePath).data.value == null ||
             !(get(deadlinePath).data.value is timestamp) ||
             request.time < get(deadlinePath).data.value;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow read, write: if isAdmin();
    }

    match /invites/{inviteId} {
      allow get: if true; // Open read for invites by ID
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidInvite(incoming()) && 
                    (!incoming().keys().hasAny(['created_at']) || incoming().created_at == request.time);
      allow update: if isAdmin() && isValidInvite(incoming()) && 
                    (incoming().created_at == existing().created_at || incoming().created_at == request.time);
      allow delete: if isAdmin();
    }

    match /guests/{guestId} {
      // Guest doc IDs are unguessable Firestore auto-IDs, so a single-doc get
      // is only reachable by someone who already has that guest's RSVP link.
      // `list` stays admin-only so the collection can't be scraped/enumerated.
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin() && isValidGuest(incoming()) &&
                    (!incoming().keys().hasAny(['updated_at']) || incoming().updated_at == request.time);
      
      allow update: if (isAdmin() && isValidGuest(incoming()) && incoming().updated_at == request.time)
        || (
          // RSVP Action: guests may change 'is_coming'/'updated_at', and may
          // additionally *clear* (never set) their table assignment — e.g.
          // when declining after having been seated, so a stale seat can't
          // silently reappear if they later re-confirm as attending. Table
          // fields may only be nulled, and only alongside a non-attending
          // response; admins (above) aren't subject to this restriction.
          incoming().diff(existing()).affectedKeys().hasOnly(['is_coming', 'updated_at', 'table_type', 'table_number', 'table_order']) &&
          incoming().updated_at == request.time &&
          isBeforeRsvpDeadline() &&
          (
            !incoming().diff(existing()).affectedKeys().hasAny(['table_type', 'table_number', 'table_order']) ||
            (
              incoming().is_coming != true &&
              incoming().table_type == null &&
              incoming().table_number == null &&
              incoming().table_order == null
            )
          )
        );
        
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSetting(settingId, incoming());
    }
  }
}
