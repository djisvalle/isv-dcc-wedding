rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email_verified == true &&
             (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
              (request.auth.token.email in ["israelvalle48@gmail.com", "debcarumba@gmail.com", "joshj.alzate77@gmail.com"])); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    // --- Entity Validations ---
    function isValidInvite(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!data.keys().hasAny(['created_at']) || data.created_at == request.time || data.created_at == null);
    }

    function isValidGuest(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!data.keys().hasAny(['nickname']) || data.nickname == null || (data.nickname is string && data.nickname.size() <= 100)) &&
             (!data.keys().hasAny(['invite_id']) || (data.invite_id == null || isValidId(data.invite_id))) &&
             (!data.keys().hasAny(['role']) || data.role == null || (data.role is string && data.role.size() <= 100)) &&
             (!data.keys().hasAny(['table_type']) || data.table_type == null || data.table_type in ['bridal', 'vip', 'regular']) &&
             (!data.keys().hasAny(['table_number']) || data.table_number == null || (data.table_number is string && data.table_number.size() <= 50)) &&
             (!data.keys().hasAny(['table_order']) || data.table_order == null || data.table_order is number) &&
             (!data.keys().hasAny(['is_coming']) || data.is_coming == null || data.is_coming is bool) &&
             (!data.keys().hasAny(['updated_at']) || data.updated_at == request.time || data.updated_at == null);
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['key', 'value']) &&
             data.key is string && data.key.size() > 0 &&
             data.value is string && data.value.size() >= 0;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow read, write: if isAdmin();
    }

    match /invites/{inviteId} {
      allow get: if true; // Open read for invites by ID
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidInvite(incoming());
      allow update: if isAdmin() && isValidInvite(incoming());
      allow delete: if isAdmin();
    }

    match /guests/{guestId} {
      // Allow listing guests if filtered by invite_id
      allow list: if isAdmin() || (
        resource.data.invite_id != null
      );
      
      allow get: if isAdmin() || resource.data.invite_id != null;

      allow create: if isAdmin() && isValidGuest(incoming());
      
      allow update: if isAdmin() 
        || (
          // RSVP Action: only allow 'is_coming' and 'updated_at' to be changed
          incoming().diff(existing()).affectedKeys().hasOnly(['is_coming', 'updated_at']) &&
          incoming().updated_at == request.time
        );
        
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSetting(incoming());
    }
  }
}
