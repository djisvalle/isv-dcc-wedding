{
  "entities": {
    "Invite": {
      "title": "Invite",
      "description": "Information about an invitation group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "import_order": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Individual guest information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invite_id": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "is_coming": { "type": "boolean" },
        "role": { "type": "string" },
        "table_type": { "type": "string", "enum": ["bridal", "vip", "regular"] },
        "table_number": { "type": "string" },
        "table_order": { "type": "number" },
        "import_order": { "type": "number" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator emails",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" }
      },
      "required": ["email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "value"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Wedding supplier information and budget",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "budget": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record for a supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplier_id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "remarks": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "scheduled"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["supplier_id", "amount", "date", "status"]
    },
    "WaitingGuest": {
      "title": "Waiting Guest",
      "description": "Guest on the waiting list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "notes": { "type": "string" },
        "priority": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Collection of wedding invitations"
    },
    "/guests/{guestId}": {
      "schema": "Guest",
      "description": "Collection of individual guests"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of admin users"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Collection of application settings"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Wedding suppliers and their budgets"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Record of payments made to suppliers"
    },
    "/waiting_list/{waitingId}": {
      "schema": "WaitingGuest",
      "description": "Guests waiting for an available spot"
    }
  }
}
